# =================================================================
# TOLK - Environment Configuration
# =================================================================
# For Local Development:
# Copy this file to .env and insert your personal API keys.
# (Do NOT commit .env to GitHub - it is automatically ignored).
#
# For Vercel Deployment:
# Add these three keys under your Vercel Project Settings -> Environment Variables.

# AssemblyAI API Key (Speech-to-Text)
# Obtain your free API key at: https://www.assemblyai.com/
ASSEMBLYAI_KEY=your_assemblyai_api_key_here

# ElevenLabs Secret API Key (Text-to-Speech / Voice Synthesis)
# Obtain your secret API key (starts with 'sk_') at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_KEY=sk_your_elevenlabs_secret_key_here

# ElevenLabs Voice ID (Defaults to George or your chosen Voice ID)
ELEVENLABS_VOICE_ID=wXvR48IpOq9HACltTmt7

# Server Host & Port (Local execution only)
PORT=5000
HOST=127.0.0.1
