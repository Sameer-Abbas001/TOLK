# =================================================================
# TOLK - Environment Configuration Example
# =================================================================
# Copy this file to .env and fill in your API keys.
# You can also configure API keys and custom voice IDs directly 
# in the web UI Settings Modal.

# AssemblyAI API Key (Speech-to-Text)
# Get your free key at: https://www.assemblyai.com/
ASSEMBLYAI_KEY=your_assemblyai_api_key_here

# ElevenLabs API Key (Voice-to-Voice / Neural TTS Synthesis)
# Get your API key at: https://elevenlabs.io/
ELEVENLABS_KEY=your_elevenlabs_api_key_here

# ElevenLabs Custom Voice ID (Optional - defaults to high quality multilingual voice)
ELEVENLABS_VOICE_ID=gO8Kb3hHPEPElVxVHDwT

# Server Port (Optional, default is 5000 or auto-discovered free port)
PORT=5000
HOST=127.0.0.1
